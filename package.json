{
  "name": "savepoint",
  "version": "0.1.2",
  "private": true,
  "description": "Savepoint: blast-radius gate, staging airlock and deterministic revert for AI agent actions",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w savepoint-mcp",
    "db:seed": "npm run db:seed -w savepoint-mcp",
    "dev": "npm run dev -w savepoint-mcp",
    "worker": "npm run worker -w savepoint-mcp",
    "demo": "npm run demo -w savepoint-mcp",
    "dashboard": "npm run dashboard -w savepoint-mcp",
    "test": "npm test -w savepoint-mcp",
    "drill:5tool": "npm run drill:5tool -w savepoint-mcp"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
