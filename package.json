{
  "name": "savepoint",
  "version": "0.1.0",
  "private": true,
  "description": "Savepoint: blast-radius gate, staging airlock and deterministic revert for AI agent actions",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @savepoint/server",
    "db:seed": "npm run db:seed -w @savepoint/server",
    "dev": "npm run dev -w @savepoint/server",
    "worker": "npm run worker -w @savepoint/server",
    "demo": "npm run demo -w @savepoint/server",
    "dashboard": "npm run dashboard -w @savepoint/server"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
