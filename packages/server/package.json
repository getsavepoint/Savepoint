{
  "name": "@savepoint/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "dev": "tsx src/mcp/stdio.ts",
    "worker": "tsx src/scripts/airlock-worker.ts",
    "demo": "tsx src/scripts/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1"
  }
}
