# --- Local Docker services (docker compose up -d) ---
DATABASE_URL=postgres://savepoint:savepoint_dev_password@localhost:5432/savepoint_db
REDIS_URL=redis://localhost:6379

# Mailpit SMTP (web UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=savepoint-agent@savepoint.local

# Stripe TEST key only (sk_test_...). Live keys are refused by the prototype.
STRIPE_SECRET_KEY=

# LLM provider key for the agent driving Savepoint (unused by the proxy itself)
LLM_API_KEY=

# --- Savepoint gate / airlock tuning (defaults shown) ---
SAVEPOINT_MAX_ROWS=10
SAVEPOINT_MAX_AMOUNT_CENTS=100000
SAVEPOINT_AIRLOCK_SECONDS=60
SAVEPOINT_RUN_AIRLOCK_WORKER=true
